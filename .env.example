# ============================================================================
#  CASA DAS ESTRELAS — variáveis de ambiente
#  Copiar para `.env.local` (nunca versionar) e preencher com valores reais.
#  Este repositório NUNCA contém credenciais.
# ============================================================================

# ---------- Site -------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://casadasestrelas.tv

# ---------- Supabase ---------------------------------------------------------
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# NUNCA expor no cliente. Usada apenas no servidor (operações auditadas).
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Redis gerido (cache, rate limiting, filas) -----------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------- Fornecedores de pagamento ---------------------------------------
# Activar apenas após homologação e contrato com o fornecedor autorizado.
PAYMENT_MPESA_API_KEY=
PAYMENT_MPESA_WEBHOOK_SECRET=
PAYMENT_EMOLA_API_KEY=
PAYMENT_EMOLA_WEBHOOK_SECRET=
PAYMENT_MKESH_API_KEY=
PAYMENT_MKESH_WEBHOOK_SECRET=
PAYMENT_CARD_PROVIDER_KEY=
PAYMENT_CARD_WEBHOOK_SECRET=

# ---------- Canais de notificação -------------------------------------------
# Email: Notifica (plataforma moçambicana — SMS, email, WhatsApp, push).
# Service token obtido no painel: https://notifica.co.mz
# https://notifica.co.mz/docs/api/email
NOTIFICA_API_TOKEN=
# Remetente tem de constar em GET /email/senders
NOTIFICA_EMAIL_FROM=noreply@notifica.co.mz
# Opcional: sobrescrever o endpoint (sandbox/homologação)
NOTIFICA_API_URL=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# SMS / WhatsApp — a Notifica serve os dois canais; ativar apenas depois de
# homologar os remetentes (sender IDs) no painel do fornecedor.
NOTIFICA_SMS_SENDER_ID=
NOTIFICA_WHATSAPP_FROM=

# ---------- Protecção do worker/cron ----------------------------------------
CRON_SECRET=

# ---------- Observabilidade --------------------------------------------------
SENTRY_DSN=
